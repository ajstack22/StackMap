{
  "name": "stackmap",
  "version": "1.3.0",
  "description": "StackMap - Visual Daily Activity Tracker",
  "private": true,
  "scripts": {
    "test": "node tests/story-runner.js",
    "test:story": "node tests/story-runner.js",
    "test:critical": "node tests/story-runner.js --critical-only",
    "test:debug": "node tests/story-runner.js --debug",
    "test:ci": "node tests/run-tests-ci.js",
    "test:browser": "node tests/run-tests.js",
    "test:watch": "nodemon tests/run-tests.js",
    "test:legacy": "node tests/test-runner-enhanced.js",
    "serve": "npx http-server -p 5502",
    "deploy": "npm run tollgate && bash scripts/deploy.sh",
    "deploy:force": "echo 'Use npm run deploy instead' && exit 1",
    "tollgate": "node scripts/deployment-tollgate.js",
    "tollgate:check": "node scripts/deployment-tollgate.js",
    "setup": "npm install && bash scripts/setup-git-hooks.sh",
    "precommit": "bash .githooks/pre-commit",
    "prepush": "bash .githooks/pre-push",
    "ci:install": "npm ci --prefer-offline --no-audit --no-fund",
    "ci:install-fast": "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true npm ci --prefer-offline --no-audit --no-fund",
    "ci:install-prod": "npm ci --production --prefer-offline --no-audit --no-fund",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "build:capacitor": "bash scripts/build-capacitor.sh",
    "ios:build": "bash scripts/build-capacitor.sh && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:build:debug": "cd android && ./build-debug.sh",
    "android:build:release": "cd android && ./build-release.sh",
    "android:install": "cd android && ./install-debug.sh"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "chalk": "^4.1.2",
    "http-server": "^14.1.1",
    "nodemon": "^3.0.0",
    "puppeteer": "^21.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "react-native-document-picker": "^9.3.1",
    "react-native-fs": "^2.20.0",
    "react-native-share": "^12.1.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.27"
  }
}
