{
  "name": "stackmap",
  "version": "1.0.0",
  "description": "StackMap - Visual Daily Activity Tracker",
  "private": true,
  "scripts": {
    "test": "node tests/run-tests-ci.js",
    "test:browser": "node tests/run-tests.js",
    "test:watch": "nodemon tests/run-tests.js",
    "serve": "npx http-server -p 5500",
    "deploy": "bash scripts/deploy.sh",
    "setup": "npm install && bash scripts/setup-git-hooks.sh"
  },
  "devDependencies": {
    "puppeteer": "^21.0.0",
    "playwright": "^1.40.0",
    "chalk": "^4.1.2",
    "http-server": "^14.1.1",
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}