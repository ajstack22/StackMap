{
  "name": "StackMap",
  "version": "2025.10.26.4",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:pre-commit": "jest --bail --findRelatedTests",
    "test:smoke": "jest --testPathPattern='(encryptionService|secureStorage|minimalSync)' --testNamePattern='(should encrypt|should decrypt|should sync)' --maxWorkers=1",
    "test:critical": "jest --testPathPattern='(encryption|secureStorage|secureId|minimalSync|conflictResolver|syncDeterministic|syncDataTransformation|recoveryPhrase)' --bail --maxWorkers=1",
    "test:important": "jest --testPathPattern='(stores/__tests__|dataNormalizer|importExportValidation|fileProcessingUtils|activityCrudLogic|fieldAccessors|syncQueue|syncOperation|services/api/dev/tests/unit|rateLimit)'",
    "test:ui": "jest --testPathPattern='(components/.*/__tests__|__tests__/workflows|services/api/dev/tests/integration|constants/__tests__)' --passWithNoTests",
    "test:coverage:critical": "jest --testPathPattern='(encryption|secureStorage|secureId|minimalSync|conflictResolver|syncDeterministic|recoveryPhrase)' --coverage --coverageThreshold='{\"global\":{\"statements\":80,\"branches\":75,\"functions\":80,\"lines\":80}}'",
    "test:watch:critical": "jest --watch --testPathPattern='(encryption|secureStorage|secureId|minimalSync)'",
    "test:watch:important": "jest --watch --testPathPattern='(stores/__tests__|dataNormalizer|importExport)'",
    "web": "webpack serve --mode development",
    "build:web": "webpack --mode production",
    "web:build": "NODE_ENV=production webpack --mode production",
    "deploy:qual": "echo '🚨 BUILD AND COPY FILES FOR QUAL DEPLOYMENT' && NODE_ENV=production npm run build:web && cp web/build/*.* . && cp -r web/build/fonts . && cp -r web/build/icons . && echo '✅ Files copied to root - NOW: git add -A && git commit && git push'",
    "security:audit": "npm audit --audit-level=high",
    "security:snyk": "npx snyk test --severity-threshold=high",
    "security:all": "npm run security:audit && npm run security:snyk",
    "prebuild:web": "npm run security:audit",
    "build:secure": "npm run security:audit && npm run build:web",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "check:methods": "./scripts/check-method-calls.sh",
    "check:all": "npm run lint && npm run typecheck && npm run check:methods",
    "prettier": "prettier --write \"src/**/*.{js,ts,tsx}\" \"App.js\"",
    "prettier:check": "prettier --check \"src/**/*.{js,ts,tsx}\" \"App.js\"",
    "sonar": "./scripts/sonar-analysis.sh",
    "quality": "npm run sonar",
    "license:check": "license-checker --production --summary",
    "license:report": "license-checker --production --csv --out docs/security/licenses.csv",
    "license:verify": "license-checker --production --failOn 'GPL;AGPL;LGPL;SSPL'"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native/new-app-screen": "0.81.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "emoji-datasource-apple": "^15.1.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.5",
    "pako": "^2.1.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.80.1",
    "react-native-document-picker": "^9.3.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^2.12.2",
    "react-native-pager-view": "^6.9.1",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-svg": "^15.12.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.20.0",
    "redis": "^5.8.3",
    "setimmediate": "^1.0.5",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "19.0.0",
    "@react-native-community/cli-platform-android": "19.0.0",
    "@react-native-community/cli-platform-ios": "19.0.0",
    "@react-native/babel-preset": "0.80.1",
    "@react-native/eslint-config": "0.80.1",
    "@react-native/metro-config": "0.80.1",
    "@react-native/typescript-config": "0.80.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-react-native-web": "^0.20.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^8.19.0",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-security": "^3.0.1",
    "glob": "^11.0.3",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^29.6.3",
    "jest-environment-jsdom": "^30.1.2",
    "jetifier": "^2.0.0",
    "node-fetch": "^2.7.0",
    "prettier": "2.8.8",
    "process": "^0.11.10",
    "react-native-svg-web": "^1.0.9",
    "react-test-renderer": "19.1.0",
    "style-loader": "^4.0.0",
    "supertest": "^7.1.4",
    "ts-loader": "^9.5.4",
    "typescript": "^5.0.4",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
