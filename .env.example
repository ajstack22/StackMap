# StackMap Environment Variables Example
# Copy this file to .env and fill in your values

# Google Drive API (optional - for cloud sync)
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_API_KEY=your_google_api_key_here

# Google Drive App ID (optional)
GOOGLE_APP_ID=your_google_app_id_here

# Note: These are loaded via env-loader.js and used in drive-sync.js
# See docs/internal/API_KEYS_SETUP.md for detailed setup instructions