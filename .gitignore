# /bundle.*.js.LICENSE.txt
/temp/
/index.html
/service-worker.js
/workbox-*.js
/manifest.json
/*.png
/fonts/
/icons/

# Android bundle files (generated during build)
/android/app/src/main/assets/index.android.bundle
/android/app/src/main/assets/index.android.bundle.map

# Duplicate android directory
/android/android/

# Test/debug files
/test-*.html
/check-*.php
/debug-*.html
/show-*.php
/clear-cache.html

# Web build should be in web/build/, not root
# Files should be deployed from web/build/, not copied to root

