{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Android Debug",
            "type": "shell",
            "command": "./scripts/mobile-build-automation.sh",
            "args": ["android", "debug"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Android Release",
            "type": "shell",
            "command": "./scripts/mobile-build-automation.sh",
            "args": ["android", "release"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Build iOS Debug",
            "type": "shell",
            "command": "./scripts/mobile-build-automation.sh",
            "args": ["ios", "debug"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "osx": {
                "options": {
                    "env": {
                        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
                    }
                }
            }
        },
