{
  // StackMap VS Code Workspace Settings
  "window.title": "🗺️ StackMap - ${activeEditorShort}",
  
  // Existing settings
  "liveServer.settings.port": 5502,
  
  // Editor settings
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.rulers": [80, 120],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  
  // File associations
  "files.associations": {
    "*.js": "javascript",
    "*.json": "jsonc",
    ".stackmap-*": "shellscript"
  },
  
  // Exclude patterns
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  
  // Search exclude
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/logs": true,
    "**/*.log": true
  },
  
  // Terminal integration
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.env.osx": {
    "STACKMAP_DEV": "true"
  },
  "terminal.integrated.shellIntegration.enabled": true,
  
  // Git integration
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.postCommitCommand": "push",
  
  // ESLint
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "html"
  ],
  
  // Project-specific snippets
  "editor.snippetSuggestions": "top",
  
  // Workspace colors (commented out - uncomment to enable green theme)
  // "workbench.colorCustomizations": {
  //   "titleBar.activeBackground": "#2E7D32",
  //   "titleBar.activeForeground": "#FFFFFF",
  //   "activityBar.background": "#388E3C",
  //   "activityBar.foreground": "#FFFFFF",
  //   "statusBar.background": "#1B5E20",
  //   "statusBar.foreground": "#FFFFFF"
  // },
  
  // Quick suggestions
  "editor.quickSuggestions": {
    "strings": true,
    "comments": false,
    "other": true
  },
  
  // Auto save
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  
  // Debugging
  "debug.console.fontSize": 14,
  "debug.console.fontFamily": "Monaco, 'Courier New', monospace"
}