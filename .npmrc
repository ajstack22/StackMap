# NPM configuration for faster installs

# Skip funding messages
fund=false

# Prefer offline mode when possible
prefer-offline=true

# Set log level to reduce output
loglevel=warn

# Skip update notifier
update-notifier=false

# Puppeteer specific - skip Chromium download
puppeteer_skip_chromium_download=true
PUPPETEER_SKIP_DOWNLOAD=true

# Don't run scripts automatically (security)
ignore-scripts=false

# Cache settings
cache-max=Infinity
cache-min=0