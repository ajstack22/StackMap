name: Deploy to Qual

on:
  push:
    branches: [main]
  workflow_dispatch:  # Allow manual trigger

jobs:
  deploy:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v3
        with:
          fetch-depth: 0  # Need full history for deployment metadata
      
      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'
          cache: 'npm'
      
      - name: Install dependencies
        run: npm ci
      
      - name: Run tests
        run: npm test --if-present
        continue-on-error: true  # Don't block deployment for test failures (for now)
      
      - name: Build project
        run: NODE_ENV=production npm run build:web
      
      - name: Prepare deployment branch
        run: |
          # Configure git
          git config user.name "GitHub Actions"
          git config user.email "actions@github.com"
          
          # Store main branch info
          MAIN_COMMIT=$(git rev-parse --short HEAD)
          MAIN_MSG=$(git log -1 --pretty=%B)
          VERSION=$(node -p "require('./package.json').version")
          
          # Switch to deployment branch
          git checkout -B deploy-qual
          
          # Copy build files to root
          cp web/build/*.html .
          cp web/build/*.json .
          cp web/build/*.js .
          cp web/build/*.txt . 2>/dev/null || true
          cp -r web/build/fonts . 2>/dev/null || true
          cp -r web/build/icons . 2>/dev/null || true
          
          # Stage only current build files
          git add -f index.html manifest.json service-worker.js workbox-*.js
          
          # Add current bundle (extract hash from index.html)
          BUNDLE_HASH=$(grep -o 'bundle\.[a-f0-9]*\.js' index.html | head -1 | sed 's/bundle\.\([a-f0-9]*\)\.js/\1/')
          [ -n "$BUNDLE_HASH" ] && git add -f "bundle.${BUNDLE_HASH}.js"*
          
          # Add assets
          git add -f fonts/ icons/ 2>/dev/null || true
          
          # Commit with metadata
          git commit -m "Deploy to qual: $(date +%Y-%m-%d_%H:%M:%S)
          
          Source: main@${MAIN_COMMIT}
          Message: ${MAIN_MSG}
          Build: NODE_ENV=production
          Version: ${VERSION}
          Action: ${{ github.run_number }}"
      
      - name: Push deployment branch
        run: |
          git push -f origin deploy-qual
      
      - name: Deploy to server
        env:
          DEPLOY_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
          DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
        run: |
          # Setup SSH
          mkdir -p ~/.ssh
          echo "$DEPLOY_KEY" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          
          # Add host to known_hosts
          ssh-keyscan -H $DEPLOY_HOST >> ~/.ssh/known_hosts
          
          # Trigger deployment on server
          ssh -i ~/.ssh/deploy_key ${DEPLOY_USER}@${DEPLOY_HOST} \
            "cd ~/public_html/qual && git fetch && git reset --hard origin/deploy-qual"
      
      - name: Notify deployment
        if: always()
        run: |
          if [ "${{ job.status }}" == "success" ]; then
            echo "✅ Deployed to https://stackmap.app/qual/"
          else
            echo "❌ Deployment failed"
          fi