{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // Allow gradual migration from JavaScript
    "allowJs": true,
    "checkJs": false,
    
    // Start with permissive settings
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    
    // Path aliases for cleaner imports
    "baseUrl": ".",
    "paths": {
      "@services/*": ["src/services/*"],
      "@stores/*": ["src/stores/*"],
      "@components/*": ["src/components/*"],
      "@utils/*": ["src/utils/*"],
      "@hooks/*": ["src/hooks/*"]
    },
    
    // React Native specific
    "jsx": "react-native",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    
    // Only type-check, don't emit
    "noEmit": true,
    
    // Incremental compilation for speed
    "incremental": true
  },
  "include": [
    "src/**/*",
    "App.js",
    "index.js",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "web/build",
    "scripts"
  ]
}
