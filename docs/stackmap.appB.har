          "content": {
            "size": 3471,
            "mimeType": "text/html",
            "text": "<!doctype html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\"><meta name=\"theme-color\" content=\"#667eea\"><link rel=\"manifest\" href=\"./manifest.json\"><meta name=\"mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\"><meta name=\"apple-mobile-web-app-title\" content=\"StackMap\"><link rel=\"apple-touch-icon\" href=\"./icons/icon-152.png\"><link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"./icons/icon-192.png\"><link rel=\"icon\" type=\"image/png\" sizes=\"512x512\" href=\"./icons/icon-512.png\"><meta name=\"description\" content=\"Visual task manager for organizing your daily activities\"><meta property=\"og:title\" content=\"StackMap\"><meta property=\"og:description\" content=\"Visual task manager for organizing your daily activities\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:image\" content=\"/icons/icon-512.png\"><title>StackMap</title><link href=\"https://fonts.googleapis.com/icon?family=Material+Icons\" rel=\"stylesheet\"><style>/* Reset and base styles */\n    * {\n      box-sizing: border-box;\n    }\n    \n    html, body, #root {\n      margin: 0;\n      padding: 0;\n      height: 100%;\n      width: 100%;\n      overflow: hidden;\n    }\n    \n    body {\n      font-family: 'Comic Relief', 'Comic Sans MS', cursive, -apple-system, BlinkMacSystemFont, sans-serif;\n      -webkit-font-smoothing: antialiased;\n      -moz-osx-font-smoothing: grayscale;\n    }\n    \n    /* Loading screen */\n    .loading {\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      height: 100vh;\n      background-color: #f7fafc;\n    }\n    \n    .spinner {\n      width: 50px;\n      height: 50px;\n      border: 3px solid #e2e8f0;\n      border-top-color: #667eea;\n      border-radius: 50%;\n      animation: spin 1s linear infinite;\n    }\n    \n    @keyframes spin {\n      to { transform: rotate(360deg); }\n    }</style><script>// Set up global object\n    if (typeof global === 'undefined') {\n      window.global = window;\n    }\n    \n    // Mock native bridge to prevent React Native errors\n    window.__fbBatchedBridgeConfig = {\n      remoteModuleConfig: [],\n      localModulesConfig: [],\n    };\n    \n    // Mock TurboModuleRegistry for native modules\n    window.__turboModuleProxy = function(name) {\n      if (name === 'SourceCode') {\n        return {\n          getConstants: () => ({\n            scriptURL: 'http://localhost:8081/index.bundle?platform=web',\n          }),\n        };\n      }\n      if (name === 'DeviceInfo') {\n        return {\n          getConstants: () => ({\n            Dimensions: {\n              window: {\n                width: window.innerWidth || 1024,\n                height: window.innerHeight || 768,\n                scale: 1,\n                fontScale: 1,\n              },\n              screen: {\n                width: window.screen?.width || window.innerWidth || 1024,\n                height: window.screen?.height || window.innerHeight || 768,\n                scale: 1,\n                fontScale: 1,\n              },\n            },\n            isTablet: false,\n            isEmulator: false,\n          }),\n        };\n      }\n      return null;\n    };</script><script defer=\"defer\" src=\"./bundle.ec8df50e283305079f6e.js\"></script></head><body><div id=\"root\"><div class=\"loading\"><div class=\"spinner\"></div></div></div></body></html>"
