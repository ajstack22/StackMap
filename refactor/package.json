{
  "name": "stackmap-refactor",
  "version": "1.0.0",
  "description": "StackMap mobile-first refactor with SQLite storage",
  "main": "index.html",
  "scripts": {
    "build": "./build.sh",
    "sync": "npm run build && npx cap sync",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android",
    "serve": "npx serve www"
  },
  "keywords": [
    "adhd",
    "task-management",
    "mobile",
    "capacitor"
  ],
  "author": "StackMap Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.1.1",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  },
  "browserslist": [
    "Android >= 6",
    "iOS >= 10",
    "Chrome >= 51",
    "Safari >= 10",
    "Firefox >= 54"
  ]
}
