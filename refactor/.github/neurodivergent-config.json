{
  "accessibility": {
    "colorSafety": {
      "prohibited": [
        {
          "color": "#ffff00",
          "name": "Pure Yellow",
          "reason": "85% of ASD users find it sensory-overloading"
        },
        {
          "color": "#ffffff",
          "name": "Pure White",
          "reason": "Too harsh, causes visual stress"
        },
        {
          "color": "#ff0000",
          "name": "Bright Red",
          "reason": "Can cause hyperactivity in ADHD users"
        }
      ],
      "recommended": {
        "primary": [
          "#5a6c40",
          "#72c604",
          "#7acedc",
          "#0c96e4"
        ],
        "neutral": [
          "#f2f2ff",
          "#e5e5ff",
          "#f8f8f8",
          "#1a1a1a"
        ]
      },
      "contrastMinimum": 6.0
    },
    "animation": {
      "timingLimits": {
        "minimum": 100,
        "maximum": 400,
        "preferred": 200
      },
      "prohibited": [
        "parallax",
        "infinite",
        "auto-playing"
      ],
      "simultaneousLimit": 2
    },
    "cognitiveComplexity": {
      "maxPerFunction": 10,
      "maxPerFile": 50,
      "readingLevel": 8,
      "maxWordsPerSentence": 20,
      "maxItemsPerView": 5
    },
    "sensoryProfiles": [
      {
        "name": "focus",
        "description": "ADHD-optimized dark theme with reduced motion",
        "settings": {
          "theme": "dark",
          "textScale": 1.2,
          "motionReduced": true,
          "audioEnabled": false,
          "hapticIntensity": 0.5,
          "animationSpeed": 0.8
        }
      },
      {
        "name": "calm",
        "description": "Autism-friendly muted colors with slower transitions",
        "settings": {
          "theme": "soft",
          "textScale": 1.1,
          "motionReduced": true,
          "audioEnabled": true,
          "audioType": "nature",
          "hapticIntensity": 0.2,
          "animationSpeed": 0.5
        }
      },
      {
        "name": "minimal",
        "description": "Text-only mode for sensory overwhelm",
        "settings": {
          "theme": "minimal",
          "textScale": 1.0,
          "motionReduced": true,
          "audioEnabled": false,
          "hapticIntensity": 0,
          "animationSpeed": 0,
          "hideImages": true
        }
      },
      {
        "name": "energy",
        "description": "Sensory-seeking mode with clear feedback",
        "settings": {
          "theme": "high-contrast",
          "textScale": 1.0,
          "motionReduced": false,
          "audioEnabled": true,
          "hapticIntensity": 0.8,
          "animationSpeed": 1.0
        }
      }
    ]
  },
  "platforms": {
    "android": {
      "minApi": 22,
      "minWebView": 37,
      "capacitorVersion": "4.x",
      "memoryLimit": "192MB",
      "es5Required": true
    },
    "ios": {
      "minVersion": "12.0",
      "supportedDevices": ["iPhone", "iPad", "iPod touch"],
      "requiredCapabilities": ["arm64"]
    },
    "chromebook": {
      "keyboardNavRequired": true,
      "touchSupport": "optional",
      "minResolution": "1366x768"
    },
    "tv": {
      "minTargetSize": "60px",
      "voiceControlRequired": true,
      "spatialNavigation": true
    }
  },
  "testing": {
    "requiredChecks": [
      "es5-compatibility",
      "accessibility-validation",
      "sensory-pattern-detection",
      "cognitive-complexity"
    ],
    "deviceMatrix": [
      {
        "platform": "android",
        "versions": ["5.1", "8.0", "10", "13"]
      },
      {
        "platform": "ios",
        "versions": ["16.4", "17.0"],
        "devices": ["iPad", "iPad Pro"]
      },
      {
        "platform": "chromebook",
        "browsers": ["Chrome 90+"]
      }
    ]
  },
  "errorHandling": {
    "preventionRatio": 0.7,
    "recoveryRatio": 0.3,
    "undoLevels": {
      "visible": 15,
      "total": 100
    },
    "errorMessageTone": "supportive",
    "panicRecovery": {
      "enabled": true,
      "resetButton": "always-visible",
      "autoSaveInterval": 30
    }
  },
  "notifications": {
    "batching": {
      "enabled": true,
      "intervals": ["morning", "afternoon", "evening"],
      "maxPerBatch": 3
    },
    "sensoryLevels": {
      "silent": {
        "visual": false,
        "audio": false,
        "haptic": false
      },
      "gentle": {
        "visual": true,
        "audio": false,
        "haptic": false
      },
      "normal": {
        "visual": true,
        "audio": true,
        "haptic": true
      }
    }
  }
}