// ============================================
// Stage Environment Configuration
// ============================================
// This configuration is used for stage deployment (internal testing)
// Bundle ID suffix allows side-by-side installation with other environments

// Include CocoaPods configuration
#include? "Pods/Target Support Files/Pods-StackMap/Pods-StackMap.stage.xcconfig"

// Bundle Identifier (shared with all environments - differentiated via TestFlight groups)
PRODUCT_BUNDLE_IDENTIFIER = app.stackmap

// App Display Name (shown on home screen)
PRODUCT_NAME = StackMap STAGE

// Build Type Environment (accessible at runtime via Info.plist)
BUILD_TYPE_ENV = stage

// Code signing (use app-store for TestFlight distribution)
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 84W9WSYQQB

// Swift compilation flag for build type detection (compile-time constant)
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) STAGE
