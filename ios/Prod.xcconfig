// ============================================
// Production Environment Configuration
// ============================================
// This configuration is used for production deployment (App Store)
// Uses base bundle ID without suffix (production version)

// Include CocoaPods configuration
#include? "Pods/Target Support Files/Pods-StackMap/Pods-StackMap.prod.xcconfig"

// Bundle Identifier (base/production ID)
PRODUCT_BUNDLE_IDENTIFIER = app.stackmap

// App Display Name (shown on home screen)
PRODUCT_NAME = StackMap

// Build Type Environment (accessible at runtime via Info.plist)
BUILD_TYPE_ENV = prod

// Code signing (use app-store for App Store distribution)
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 84W9WSYQQB
