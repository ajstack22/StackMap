# Fastlane Environment Variables Template
# ============================================
# Copy this file to .env and fill in actual values
# DO NOT commit .env to git
#
# SECURITY: Use macOS Keychain for sensitive credentials
# See FASTLANE_SETUP_IOS.md for Keychain setup instructions

# ============================================
# APPLE ACCOUNT CREDENTIALS
# ============================================

# Apple ID for App Store Connect
# Store in Keychain using: fastlane store_credentials_in_keychain
FASTLANE_APPLE_ID="your-apple-id@email.com"

# IMPORTANT: Do NOT store passwords in plaintext
# Instead, use macOS Keychain:
# - Run: security add-generic-password -a "fastlane" -s "FASTLANE_APP_SPECIFIC_PASSWORD" -w "your-password-here"
# - Fastlane will automatically retrieve it from Keychain

# ============================================
# APP STORE CONNECT API KEY (RECOMMENDED)
# ============================================
# Generate at: https://appstoreconnect.apple.com/access/api
# This is MORE SECURE than Apple ID + password

# APP_STORE_CONNECT_API_KEY_KEY_ID="ABC123DEF4"
# APP_STORE_CONNECT_API_KEY_ISSUER_ID="12345678-1234-1234-1234-123456789012"
# APP_STORE_CONNECT_API_KEY_KEY="./AuthKey_ABC123DEF4.p8"

# ============================================
# TEAM INFORMATION
# ============================================

FASTLANE_TEAM_ID="84W9WSYQQB"
FASTLANE_ITC_TEAM_ID="84W9WSYQQB"

# ============================================
# APP INFORMATION
# ============================================

FASTLANE_APP_IDENTIFIER="app.stackmap"

# ============================================
# BUILD CONFIGURATION
# ============================================

FASTLANE_XCODE_SCHEME="StackMapNative"
FASTLANE_WORKSPACE="StackMapNative.xcworkspace"

# ============================================
# DEPLOYMENT OPTIONS
# ============================================

# Skip waiting for Apple to process the build (recommended for CI)
FASTLANE_SKIP_WAITING_FOR_BUILD_PROCESSING="true"

# Skip automatic update checks
FASTLANE_SKIP_UPDATE_CHECK="false"

# Hide timestamp in output
FASTLANE_HIDE_TIMESTAMP="false"

# ============================================
# TESTFLIGHT OPTIONS
# ============================================

# Default changelog for TestFlight builds
# TESTFLIGHT_CHANGELOG="Bug fixes and performance improvements"

# Distribute to external testers (default: internal only)
# TESTFLIGHT_DISTRIBUTE_EXTERNAL="false"

# ============================================
# KEYCHAIN SETUP INSTRUCTIONS
# ============================================
#
# To store credentials securely in macOS Keychain:
#
# 1. Store app-specific password:
#    security add-generic-password -a "fastlane" -s "FASTLANE_APP_SPECIFIC_PASSWORD" -w "abcd-efgh-ijkl-mnop"
#
# 2. Verify it's stored:
#    security find-generic-password -a "fastlane" -s "FASTLANE_APP_SPECIFIC_PASSWORD" -w
#
# 3. Fastlane will automatically retrieve it when needed
#
# For more details, see: docs/FASTLANE_SETUP_IOS.md
