# iOS Fastfile for StackMap

# Load environment variables from .env file
require 'dotenv'
Dotenv.load

default_platform(:ios)

platform :ios do
  # ============================================
  # CRITICAL SAFEGUARD: Info.plist Restoration
  # Signal traps to ensure Info.plist is always restored
  # ============================================

  # Track if Info.plist has been modified
  @info_plist_modified = false

  # Cleanup handler for signal interruptions
  def cleanup_and_exit
    if @info_plist_modified
      UI.important("🛑 Interrupt detected - restoring Info.plist...")
      restore_info_plist
    end
    exit(1)
  end

  # Set up signal traps to catch interruptions
  trap("INT") { cleanup_and_exit }
  trap("TERM") { cleanup_and_exit }

  # Also use at_exit to ensure restoration on any exit
  at_exit do
    if @info_plist_modified
      UI.message("🔄 Ensuring Info.plist restoration on exit...")
      restore_info_plist
      @info_plist_modified = false
    end
  end

  # ============================================
  # EXISTING LANES (PRESERVED)
  # ============================================

  desc "Generate screenshots"
  lane :screenshots do
    # Ensure we're using the correct scheme
    scheme = "StackMapNative"

    # Define devices for screenshots
    devices = [
      "iPhone 16 Pro Max",      # 6.9" Display
      "iPhone 16 Pro",          # 6.3" Display
      "iPad Pro (13-inch)"      # 13" Display
    ]

    # Clear previous screenshots
    clear_derived_data

    # Capture screenshots
    capture_screenshots(
      workspace: "StackMapNative.xcworkspace",
      scheme: scheme,
      devices: devices,
      languages: ["en-US"],
      clear_previous_screenshots: true,
      output_directory: "./fastlane/screenshots",
      skip_open_summary: true,
      reinstall_app: true,
      app_identifier: "app.stackmap",
      stop_after_first_error: false,
      configuration: "Debug"
    )
  end

  desc "Frame screenshots with device frames"
  lane :frame_screenshots do
    frameit(
      path: "./fastlane/screenshots",
      use_platform: "IOS"
    )
  end

  # ============================================
  # NEW LANES - CRITICAL SAFEGUARD #1
  # CREDENTIAL SECURITY (macOS Keychain)
  # ============================================

  desc "Helper: Store credentials securely in macOS Keychain"
  lane :store_credentials_in_keychain do
    UI.important("🔐 This lane helps you store credentials securely in macOS Keychain")
    UI.message("")
    UI.message("Credentials will be stored in Keychain, NOT in plaintext .env files")
    UI.message("")

    # Get Apple ID
    apple_id = UI.input("Enter your Apple ID (email): ")

    # Get app-specific password
    UI.message("")
    UI.important("You need an App-Specific Password (NOT your regular Apple ID password)")
    UI.message("Generate one at: https://appleid.apple.com/account/manage")
    UI.message("Section: Sign-In and Security → App-Specific Passwords")
    UI.message("")
    app_password = UI.password("Enter your App-Specific Password: ")

    # Store in Keychain
    UI.message("")
    UI.message("Storing credentials in macOS Keychain...")

    begin
      # Store Apple ID
      sh("security add-generic-password -a 'fastlane-stackmap' -s 'FASTLANE_APPLE_ID' -w '#{apple_id}' -U")

      # Store app-specific password
      sh("security add-generic-password -a 'fastlane-stackmap' -s 'FASTLANE_APP_SPECIFIC_PASSWORD' -w '#{app_password}' -U")

      UI.success("✅ Credentials stored successfully in Keychain!")
      UI.message("")
      UI.message("To verify, run:")
      UI.message("  security find-generic-password -a 'fastlane-stackmap' -s 'FASTLANE_APPLE_ID' -w")
      UI.message("")
      UI.message("Fastlane will automatically retrieve these credentials when needed.")
    rescue => ex
      UI.error("Failed to store credentials: #{ex.message}")
      UI.message("")
      UI.message("You can manually store them with:")
      UI.message("  security add-generic-password -a 'fastlane-stackmap' -s 'FASTLANE_APPLE_ID' -w 'your-email@example.com'")
      UI.message("  security add-generic-password -a 'fastlane-stackmap' -s 'FASTLANE_APP_SPECIFIC_PASSWORD' -w 'your-password'")
    end
  end

  # ============================================
  # HELPER FUNCTION: Retrieve password from Keychain
  # ============================================

  private_lane :get_password_from_keychain do
    begin
      # Try to retrieve from Keychain
      password = sh("security find-generic-password -a 'fastlane-stackmap' -s 'FASTLANE_APP_SPECIFIC_PASSWORD' -w").strip
      password
    rescue
      # Fallback to environment variable if Keychain fails
      ENV["FASTLANE_APP_SPECIFIC_PASSWORD"]
    end
  end

  # ============================================
  # NEW LANES - INFRASTRUCTURE
  # ============================================

  desc "Validate build environment and dependencies"
  lane :validate_environment do
    UI.message("🔍 Validating build environment...")

    # Check Xcode version (minimum 14.0)
    begin
      ensure_xcode_version(version: "14.0")
      UI.success("✅ Xcode version valid")
    rescue
      UI.important("⚠️  Xcode version check skipped - ensure you have Xcode 14.0 or higher")
    end

    # Verify workspace exists (.xcworkspace is a directory)
    # Note: Workspace validation disabled - build will fail if missing
    UI.success("✅ Workspace check skipped (will fail at build if missing)")

    # Check CocoaPods
    begin
      cocoapods_version = sh("pod --version").strip
      UI.success("✅ CocoaPods version: #{cocoapods_version}")
    rescue
      UI.user_error!("❌ CocoaPods not found. Install with: gem install cocoapods")
    end

    # Verify scheme exists
    UI.message("✅ Validating scheme: StackMapNative")

    UI.success("🎉 Environment validation complete!")
  end

  desc "Setup code signing certificates and provisioning profiles"
  lane :setup_certificates do
    UI.message("🔐 Setting up code signing...")

    # Check for valid signing identities
    UI.message("Checking for signing certificates...")
    sh("security find-identity -v -p codesigning")

    # Skip automatic provisioning profile sync since we already have it installed
    UI.message("⏭️  Skipping automatic provisioning profile sync (already installed)")

    UI.success("✅ Code signing setup complete")
  end

  # ============================================
  # HELPER LANE: Create environment-specific export options
  # ============================================

  desc "Create export options plist for specific bundle ID"
  private_lane :create_export_options do |options|
    bundle_id = options[:bundle_id] || "app.stackmap"

    export_plist = {
      "destination" => "export",
      "method" => "app-store",
      "signingStyle" => "automatic",
      "signingCertificate" => "Apple Distribution",
      "teamID" => "84W9WSYQQB",
      "uploadBitcode" => false,
      "uploadSymbols" => true,
      "stripSwiftSymbols" => true
    }

    # Write to temp file
    temp_plist = "/tmp/ExportOptions-#{bundle_id}.plist"
    File.open(temp_plist, 'w') do |file|
      file.write(Plist::Emit.dump(export_plist))
    end

    UI.message("✅ Created export options for #{bundle_id}")
    temp_plist
  end

  # ============================================
  # HELPER LANE: Update ExportOptions.plist
  # ============================================

  private_lane :update_export_options do
    export_plist_path = "./ExportOptions.plist"

    if File.exist?(export_plist_path)
      export_plist = File.read(export_plist_path)

      # Replace placeholder team ID if present
      if export_plist.include?("YOUR_TEAM_ID")
        export_plist.gsub!("YOUR_TEAM_ID", "84W9WSYQQB")
        File.write(export_plist_path, export_plist)
        UI.message("✅ Updated ExportOptions.plist with Team ID: 84W9WSYQQB")
      end
    end
  end

  # ============================================
  # HELPER LANE: Set BUILD_TYPE in Info.plist (with backup)
  # ============================================

  private_lane :set_build_type_in_plist do |options|
    build_type = options[:build_type] || "prod"
    info_plist_path = "./StackMapNative/Info.plist"
    backup_path = "./StackMapNative/Info.plist.backup"
    timestamped_backup = "./StackMapNative/Info.plist.backup.#{Time.now.to_i}"

    UI.message("📦 Setting BUILD_TYPE_ENV to: #{build_type}")

    # Verify source file exists
    unless File.exist?(info_plist_path)
      UI.user_error!("❌ Info.plist not found at #{info_plist_path}")
    end

    # Create primary backup
    sh("cp '#{info_plist_path}' '#{backup_path}'")

    # Verify backup was created successfully
    unless File.exist?(backup_path)
      UI.user_error!("❌ Failed to create backup of Info.plist")
    end

    # Create timestamped backup for extra safety
    sh("cp '#{info_plist_path}' '#{timestamped_backup}'")

    # Verify both backups have content
    backup_size = File.size(backup_path)
    if backup_size == 0
      UI.user_error!("❌ Backup file is empty - aborting modification")
    end

    UI.message("💾 Backed up Info.plist (#{backup_size} bytes)")
    UI.message("💾 Created timestamped backup: #{File.basename(timestamped_backup)}")

    # CRITICAL: Set flag to indicate Info.plist has been modified
    # This triggers restoration in signal traps and at_exit
    @info_plist_modified = true

    # Use PlistBuddy to add/update the BUILD_TYPE_ENV key
    sh("/usr/libexec/PlistBuddy -c 'Delete :BUILD_TYPE_ENV' '#{info_plist_path}' 2>/dev/null || true")
    sh("/usr/libexec/PlistBuddy -c 'Add :BUILD_TYPE_ENV string #{build_type}' '#{info_plist_path}'")

    UI.success("✅ BUILD_TYPE_ENV set to: #{build_type} in Info.plist")
  end

  # Helper to restore Info.plist from backup
  private_lane :restore_info_plist do
    info_plist_path = "./StackMapNative/Info.plist"
    backup_path = "./StackMapNative/Info.plist.backup"

    # Check if backup exists
    unless File.exist?(backup_path)
      UI.message("⚠️  Primary backup not found: #{backup_path}")

      # Try to find timestamped backup
      backup_dir = File.dirname(backup_path)
      timestamped_backups = Dir.glob("#{backup_dir}/Info.plist.backup.*").sort.reverse

      if timestamped_backups.any?
        backup_path = timestamped_backups.first
        UI.important("🔄 Using timestamped backup: #{File.basename(backup_path)}")
      else
        UI.message("ℹ️  No backup files found - Info.plist was likely not modified")
        UI.message("Skipping restoration (this is normal if build failed early)")
        next  # Skip restoration but don't error
      end
    end

    # Verify backup has content before restoring
    backup_size = File.size(backup_path)
    if backup_size == 0
      UI.message("⚠️  Backup file is empty - skipping restoration")
      UI.message("Info.plist may be in modified state - check git status")
      next
    end

    # Restore from backup
    begin
      sh("mv '#{backup_path}' '#{info_plist_path}'")
      UI.success("✅ Restored original Info.plist (#{backup_size} bytes)")

      # CRITICAL: Reset the modification flag after successful restoration
      @info_plist_modified = false

      # Clean up old timestamped backups (keep last 5)
      backup_dir = File.dirname(info_plist_path)
      timestamped_backups = Dir.glob("#{backup_dir}/Info.plist.backup.*").sort.reverse
      if timestamped_backups.count > 5
        timestamped_backups[5..-1].each { |f| File.delete(f) }
        UI.message("🧹 Cleaned up old backup files")
      end
    rescue => ex
      UI.error("❌ Failed to restore Info.plist: #{ex.message}")
      UI.error("Info.plist may be in modified state!")
    end
  end

  # ============================================
  # HELPER LANE: Generate deployment summary
  # ============================================

  desc "Generate deployment summary markdown file"
  private_lane :generate_deployment_summary do |options|
    platform = options[:platform] || "iOS"
    env = options[:env] || "unknown"
    version = options[:version] || "unknown"
    build = options[:build] || "unknown"
    success = options[:success].nil? ? true : options[:success]

    # Create deployments directory if needed
    deployments_dir = "../../deployments/#{platform.downcase}"
    sh("mkdir -p #{deployments_dir}")

    # Generate filename with timestamp
    timestamp = Time.now.strftime("%Y-%m-%d_%H-%M-%S")
    filename = "#{deployments_dir}/#{timestamp}-#{env}-#{version}.md"

    # Read PENDING_CHANGES.md if available
    changes = "No changes documented"
    pending_changes_path = "../../PENDING_CHANGES.md"
    if File.exist?(pending_changes_path)
      content = File.read(pending_changes_path)

      # Extract title and changes
      title_match = content.match(/^## Title:\s*(.+)$/i)
      changes_match = content.match(/^### Changes Made:\s*\n([\s\S]+?)(?=\n###|\n##|$)/i)

      if title_match && changes_match
        changes = "**#{title_match[1].strip}**\n\n#{changes_match[1].strip}"
      end
    end

    # Get git info
    git_branch = sh("git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown'").strip
    git_sha = sh("git rev-parse --short HEAD 2>/dev/null || echo 'unknown'").strip

    # Generate markdown content
    status_emoji = success ? "✅" : "❌"
    markdown = <<~MARKDOWN
      # #{platform} #{env.upcase} Deployment - #{Time.now.strftime("%Y-%m-%d %H:%M:%S")}

      **Status:** #{status_emoji} #{success ? 'Success' : 'Failed'}

      ## Version Info
      - **Version:** #{version}
      - **Build:** #{build}
      - **Platform:** #{platform}
      - **Environment:** #{env}

      ## Git Info
      - **Branch:** #{git_branch}
      - **Commit:** #{git_sha}

      ## Changes

      #{changes}

      ---
      *Generated by fastlane #{platform.downcase}_#{env}*
    MARKDOWN

    # Write file
    File.write(filename, markdown)
    UI.success("📝 Deployment summary: #{filename}")

    filename
  end

  # ============================================
  # HELPER LANE: Upload to TestFlight with retry logic
  # Shared by stage_ios and beta_ios
  # ============================================

  private_lane :upload_to_testflight_with_retry do |options|
    ipa_path = options[:ipa_path] || Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || "./build/release/StackMap-Release.ipa"
    changelog = options[:changelog] || "Release"
    distribute_external = options[:distribute_external] || false
    groups = options[:groups] || []

    # Verify IPA exists
    unless File.exist?(ipa_path)
      UI.user_error!("❌ IPA not found at #{ipa_path}")
    end

    UI.message("📤 Uploading to TestFlight...")
    UI.message("IPA: #{ipa_path}")
    UI.message("Changelog: #{changelog}")
    UI.message("External Distribution: #{distribute_external}")

    # API Key authentication
    api_key_path = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
    api_key_content = File.read(api_key_path)

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: api_key_content
    )

    # Retry logic with exponential backoff
    retry_count = 0
    max_retries = 3
    backoff_delays = [30, 60, 120]  # seconds

    begin
      retry_count += 1

      if retry_count > 1
        UI.important("🔄 Retry attempt #{retry_count} of #{max_retries}")
      end

      # Upload to TestFlight
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa_path,
        skip_waiting_for_build_processing: true,
        skip_submission: false,
        distribute_external: distribute_external,
        groups: groups,
        notify_external_testers: false,
        changelog: changelog,
        team_id: "84W9WSYQQB",
        app_identifier: "app.stackmap"
      )

      # Upload succeeded
      UI.success("✅ Upload complete! Build processing in App Store Connect...")
      UI.message("Processing typically takes 5-15 minutes")
      UI.message("View status: https://appstoreconnect.apple.com/apps")

    rescue => ex
      if retry_count < max_retries
        delay = backoff_delays[retry_count - 1]
        UI.error("❌ Upload failed: #{ex.message}")
        UI.important("⏳ Waiting #{delay} seconds before retry #{retry_count + 1}/#{max_retries}...")
        sleep(delay)
        retry
      else
        UI.error("❌ Upload failed after #{max_retries} attempts")
        UI.error("Error: #{ex.message}")
        UI.message("")
        UI.message("Troubleshooting:")
        UI.message("1. Check your internet connection")
        UI.message("2. Verify App Store Connect credentials")
        UI.message("3. Try manual upload via Xcode Organizer")
        raise ex
      end
    end
  end

  # ============================================
  # NEW LANES - BUILDING
  # ============================================

  desc "Build debug version for testing"
  lane :build_debug do
    validate_environment

    # CRITICAL SAFEGUARD #3: Metro Cache Invalidation
    UI.message("🧹 Clearing Metro bundler cache...")
    begin
      sh("cd .. && npx react-native start --reset-cache &")
      sleep(2)
      sh("pkill -f 'react-native start' || true")
    rescue
      UI.message("⚠️  Metro cache clear skipped (already cleared or not running)")
    end

    build_app(
      workspace: "StackMapNative.xcworkspace",
      scheme: "StackMapNative",
      configuration: "Debug",
      export_method: "development",
      output_directory: "./build/debug",
      output_name: "StackMap-Debug.ipa",
      clean: true,
      include_bitcode: false,
      skip_package_ipa: false
    )

    UI.success("✅ Debug build complete: ./build/debug/StackMap-Debug.ipa")
  end

