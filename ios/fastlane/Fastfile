    UI.message("")
    UI.message("Environment: STAGE (using stage/api endpoint)")
    UI.message("Bundle ID: app.stackmap.stage")
    UI.message("App Name: StackMap STAGE")
    UI.message("Distribution: Internal Testing only")
    UI.message("")
    UI.message("Next steps:")
    UI.message("1. Wait 5-15 minutes for Apple to process the build")
    UI.message("2. Check App Store Connect: https://appstoreconnect.apple.com/apps")
    UI.message("3. Distribute to internal testers for stage environment testing")
  end

  # ============================================
  # PRODUCTION DEPLOYMENT LANES
  # ============================================

  desc "Load release notes from PENDING_CHANGES.md"
  private_lane :load_release_notes_from_file do
    pending_changes_path = "../PENDING_CHANGES.md"

    if File.exist?(pending_changes_path)
      content = File.read(pending_changes_path)

      # Extract title
      title_match = content.match(/^## Title:\s*(.+)$/i)
      title = title_match ? title_match[1].strip : nil

      # Extract changes
      changes_section = content.match(/^### Changes Made:\s*\n([\s\S]+?)(?=\n###|\n##|$)/i)
      changes = changes_section ? changes_section[1].strip : nil

      # Build release notes
      if title && changes
        release_notes = "#{title}\n\n#{changes}"
        UI.message("📝 Loaded release notes from PENDING_CHANGES.md")
        release_notes
      else
        UI.message("⚠️  PENDING_CHANGES.md exists but missing title or changes")
        "Bug fixes and improvements"
      end
    else
      UI.message("⚠️  PENDING_CHANGES.md not found, using default release notes")
      "Bug fixes and improvements"
    end
  end

  desc "Build and deploy to App Store production (full submission)"
  lane :prod_ios do |options|
    UI.message("🚀 Starting production deployment pipeline...")

    # Validate environment
    validate_environment

    # Setup certificates
    setup_certificates

    # Optional: Increment build number (default: true)
    unless options[:skip_increment]
      bump_build_number
    end

    # Build with Prod configuration (handles BUILD_TYPE_ENV via xcconfig)
    UI.message("🔨 Building with Prod configuration...")
    build_app(
      workspace: "StackMapNative.xcworkspace",
      scheme: "StackMapNative",
      configuration: "Prod",  # Uses Prod.xcconfig
      export_method: "app-store",
      output_directory: "./build/prod",
      output_name: "StackMap-Prod.ipa",
      export_options: "./ExportOptions.plist",
      clean: true,
      include_bitcode: false,
      skip_package_ipa: false,
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates ONLY_ACTIVE_ARCH=NO"
    )

    # Get release notes
    changelog = options[:changelog] || ENV["RELEASE_NOTES"] || load_release_notes_from_file

    # Get IPA path
    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || "./build/prod/StackMap-Prod.ipa"

    # Verify IPA exists
    unless File.exist?(ipa_path)
      UI.user_error!("❌ IPA not found at #{ipa_path}")
    end

    # API Key authentication (same as beta)
    api_key_path = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
    api_key_content = File.read(api_key_path)

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: api_key_content
    )

    # Upload to App Store Connect with retry logic
    UI.message("📤 Uploading to App Store Connect...")

    retry_count = 0
    max_retries = 3
    backoff_delays = [30, 60, 120]  # seconds

    begin
      retry_count += 1

      if retry_count > 1
        UI.important("🔄 Retry attempt #{retry_count} of #{max_retries}")
      end

      deliver(
        api_key: api_key,
        ipa: ipa_path,
        skip_metadata: options[:skip_metadata] || false,
        skip_screenshots: options[:skip_screenshots] || true,  # Default: skip screenshots
        submit_for_review: options[:submit] || false,  # Manual approval by default
        automatic_release: options[:auto_release] || false,  # Manual release after review
        precheck_include_in_app_purchases: false,
        submission_information: {
          add_id_info_uses_idfa: false
        },
        # Use changelog if provided
        release_notes: {
          "en-US" => changelog
        }
      )

      # If we get here, upload succeeded
      UI.success("✅ Upload complete!")

    rescue => ex
      if retry_count < max_retries
        delay = backoff_delays[retry_count - 1]
        UI.error("❌ Upload failed: #{ex.message}")
        UI.important("⏳ Waiting #{delay} seconds before retry #{retry_count + 1}/#{max_retries}...")
        sleep(delay)
        retry
      else
        UI.error("❌ Upload failed after #{max_retries} attempts")
        UI.error("Error: #{ex.message}")
        UI.message("")
        UI.message("Troubleshooting:")
        UI.message("1. Check your internet connection")
        UI.message("2. Verify App Store Connect credentials")
        UI.message("3. Try manual upload via Xcode Organizer")
        raise ex
      end
    end

    # Generate deployment summary
    generate_deployment_summary(
      platform: "iOS",
      env: "prod",
      version: get_version_number,
      build: get_build_number,
      success: true
    )

    UI.success("🎉 Production deployment complete!")
    UI.message("")
    UI.message("Next steps:")
    UI.message("1. Check App Store Connect: https://appstoreconnect.apple.com/apps")
    UI.message("2. Review build details and metadata")
    if options[:submit]
      UI.message("3. Build submitted for review - monitor review status")
    else
      UI.message("3. Submit for review when ready")
    end
    UI.message("4. Monitor review status")
  end
end