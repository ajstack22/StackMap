  # ============================================
  # NEW LANES - VERSION MANAGEMENT
  # CRITICAL SAFEGUARD #2: Build Number Safety
  # ============================================

  desc "Increment build number (preserves version string)"
  lane :bump_build_number do
    UI.message("🔢 Incrementing build number...")

    # Get current local build number
    current_build = get_build_number(xcodeproj: "StackMapNative.xcodeproj").to_i
    new_build = current_build + 1

    UI.message("Current build: #{current_build}")
    UI.message("New build: #{new_build}")

    # Update build number in Xcode project using the action
    Actions.lane_context[SharedValues::BUILD_NUMBER] = new_build.to_s
    sh("cd ../  && agvtool new-version -all #{new_build}")

    UI.success("✅ Build number incremented: #{current_build} → #{new_build}")

    # Return new build number for use in other lanes
    new_build
  end

  # ============================================
  # NEW LANES - DEPLOYMENT
  # CRITICAL SAFEGUARD #4: Retry Logic
  # ============================================

  desc "Upload to TestFlight (assumes IPA already built)"
  lane :upload_testflight do |options|
    # Get changelog from environment or use default
    changelog = options[:changelog] || ENV["TESTFLIGHT_CHANGELOG"] || "Bug fixes and improvements"

    # Determine IPA path - use lane context if available, otherwise use provided path
    ipa_path = options[:ipa_path] || Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || "./build/release/StackMap-Release.ipa"

    # Verify IPA exists
    unless File.exist?(ipa_path)
      UI.user_error!("❌ IPA not found at #{ipa_path}. Build first with 'build_release'")
    end

    UI.message("📤 Uploading to TestFlight...")
    UI.message("IPA: #{ipa_path}")
    UI.message("Changelog: #{changelog}")

    # CRITICAL SAFEGUARD #1: Use API Key authentication (more secure than username/password)
    api_key_path = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
    UI.message("📁 Using API Key: #{api_key_path}")

    # Read the key content to avoid OpenSSL curve name issues in Ruby 3.3.9
    api_key_content = File.read(api_key_path)

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: api_key_content
    )

    # CRITICAL SAFEGUARD #4: Retry logic with exponential backoff
    retry_count = 0
    max_retries = 3
    backoff_delays = [30, 60, 120]  # seconds

    begin
      retry_count += 1

      if retry_count > 1
        UI.important("🔄 Retry attempt #{retry_count} of #{max_retries}")
      end

      # Upload to TestFlight using API Key authentication
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa_path,
        skip_waiting_for_build_processing: true,  # Don't wait for Apple processing
        skip_submission: false,  # Submit for beta review
        distribute_external: false,  # Internal testing only initially
        notify_external_testers: false,
        changelog: changelog,
        team_id: "84W9WSYQQB",
        app_identifier: "app.stackmap"
      )

      # If we get here, upload succeeded
      UI.success("✅ Upload complete! Build processing in App Store Connect...")
      UI.message("Processing typically takes 5-15 minutes")
      UI.message("View status: https://appstoreconnect.apple.com/apps")

    rescue => ex
      if retry_count < max_retries
        delay = backoff_delays[retry_count - 1]
        UI.error("❌ Upload failed: #{ex.message}")
        UI.important("⏳ Waiting #{delay} seconds before retry #{retry_count + 1}/#{max_retries}...")
        sleep(delay)
        retry
      else
        UI.error("❌ Upload failed after #{max_retries} attempts")
        UI.error("Error: #{ex.message}")
        UI.message("")
        UI.message("Troubleshooting:")
        UI.message("1. Check your internet connection")
        UI.message("2. Verify App Store Connect credentials")
        UI.message("3. Try manual upload via Xcode Organizer")
        raise ex
      end
    end
  end

  desc "Build and deploy to TestFlight External Testing (beta environment)"
  lane :beta_ios do |options|
    UI.message("🚀 Starting beta deployment pipeline (External Testing)...")

    # Validate environment
    validate_environment

    # Setup certificates
    setup_certificates

    # Optional: Increment build number
    if options[:skip_increment]
      UI.message("⏭️  Skipping build number increment")
    else
      bump_build_number
    end

    # Build with Beta configuration (handles BUILD_TYPE_ENV via xcconfig)
    UI.message("🔨 Building with Beta configuration...")
    build_app(
      workspace: "StackMapNative.xcworkspace",
      scheme: "StackMapNative",
      configuration: "Beta",  # Uses Beta.xcconfig
      export_method: "app-store",
      output_directory: "./build/beta",
      output_name: "StackMap-Beta.ipa",
      export_options: "./ExportOptions.plist",
      clean: true,
      include_bitcode: false,
      skip_package_ipa: false,
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates ONLY_ACTIVE_ARCH=NO"
    )

    # Get changelog
    changelog = options[:changelog] || ENV["TESTFLIGHT_CHANGELOG"] || "Beta release for external testing"

    # Upload to TestFlight External Testing using shared helper
    # Note: ipa_path automatically uses IPA_OUTPUT_PATH from lane context (set by build_app)
    upload_to_testflight_with_retry(
      changelog: changelog,
      distribute_external: true,  # External Testing for wider beta groups
      groups: ["Beta Testers"]  # External tester group (configure in App Store Connect)
    )

    # Generate deployment summary
    generate_deployment_summary(
      platform: "iOS",
      env: "beta",
      version: get_version_number,
      build: get_build_number,
      success: true
    )

    UI.success("🎉 Beta deployment complete!")
    UI.message("")
    UI.message("Environment: BETA (using beta/api endpoint)")
    UI.message("Bundle ID: app.stackmap.beta")
    UI.message("App Name: StackMap (same as prod for users)")
    UI.message("Distribution: External Testing (requires Apple beta review)")
    UI.message("")
    UI.message("Next steps:")
    UI.message("1. Wait 5-15 minutes for Apple to process the build")
    UI.message("2. Check App Store Connect: https://appstoreconnect.apple.com/apps")
    UI.message("3. Wait for Apple beta review approval (typically 24-48 hours)")
    UI.message("4. External testers in 'Beta Testers' group will be notified")
  end

  desc "Build and deploy to TestFlight Internal Testing (stage environment)"
  lane :stage_ios do |options|
    UI.message("🚀 Starting stage deployment pipeline (Internal Testing only)...")

    # Validate environment
    validate_environment

    # Setup certificates
    setup_certificates

    # Optional: Increment build number
    if options[:skip_increment]
      UI.message("⏭️  Skipping build number increment")
    else
      bump_build_number
    end

    # Build with Stage configuration (handles BUILD_TYPE_ENV via xcconfig)
    UI.message("🔨 Building with Stage configuration...")
    build_app(
      workspace: "StackMapNative.xcworkspace",
      scheme: "StackMapNative",
      configuration: "Stage",  # Uses Stage.xcconfig
      export_method: "app-store",
      output_directory: "./build/stage",
      output_name: "StackMap-Stage.ipa",
      export_options: "./ExportOptions.plist",
      clean: true,
      include_bitcode: false,
      skip_package_ipa: false,
