// ============================================
// Beta Environment Configuration
// ============================================
// This configuration is used for beta deployment (external testing)
// Bundle ID suffix allows side-by-side installation with other environments

// Include CocoaPods configuration
#include? "Pods/Target Support Files/Pods-StackMap/Pods-StackMap.beta.xcconfig"

// Bundle Identifier (shared with all environments - differentiated via TestFlight groups)
PRODUCT_BUNDLE_IDENTIFIER = app.stackmap

// App Display Name (shown on home screen - same as prod for beta users)
PRODUCT_NAME = StackMap

// Build Type Environment (accessible at runtime via Info.plist)
BUILD_TYPE_ENV = beta

// Code signing (use app-store for TestFlight distribution)
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 84W9WSYQQB
