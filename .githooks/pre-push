#!/bin/bash

# Git pre-push hook for StackMap
# Ensures deployment practices are followed before pushing to main

# Get the branch being pushed
while read local_ref local_sha remote_ref remote_sha
do
    # Check if pushing to main branch
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        echo "🔍 Pre-push validation for main branch..."
        
        # Run the pre-deployment check script
        if [ -f "scripts/pre-deploy-check.sh" ]; then
            bash scripts/pre-deploy-check.sh
            
            if [ $? -ne 0 ]; then
                echo ""
                echo "❌ Pre-push validation failed!"
                echo "Please fix the issues above before pushing to main."
                echo ""
                echo "To bypass this check (NOT RECOMMENDED), use:"
                echo "  git push --no-verify"
                echo ""
                exit 1
            fi
        else
            echo "⚠️  Warning: pre-deploy-check.sh not found"
            echo "Creating it now..."
            
            # This shouldn't happen, but let's be safe
            mkdir -p scripts
            curl -s https://raw.githubusercontent.com/ajstack22/StackMap/main/scripts/pre-deploy-check.sh > scripts/pre-deploy-check.sh
            chmod +x scripts/pre-deploy-check.sh
            
            echo "Please run: git push again"
            exit 1
        fi
    fi
done

exit 0