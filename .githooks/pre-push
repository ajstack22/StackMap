#!/bin/bash

echo "🚀 Running pre-push validation..."
echo ""

# Run comprehensive test suite
echo "🧪 Running full test suite..."
if [ -f "tests/test-runner-enhanced.js" ]; then
    node tests/test-runner-enhanced.js
    TEST_EXIT_CODE=$?
    
    if [ $TEST_EXIT_CODE -ne 0 ]; then
        echo ""
        echo "❌ PUSH BLOCKED: Tests failed!"
        echo ""
        echo "Failed tests must be fixed before pushing to remote."
        echo ""
        echo "Options:"
        echo "  1. Fix the failing tests"
        echo "  2. Run tests locally: npm test"
        echo "  3. Check detailed report: tests/reports/latest.json"
        echo ""
        exit 1
    fi
else
    echo "⚠️  Test runner not found, skipping test validation"
fi

# Check for console.log statements in production code
echo ""
echo "🔍 Checking for console.log statements..."
CONSOLE_LOGS=$(grep -r "console\.log" --include="*.js" --exclude-dir=node_modules --exclude-dir=tests . | grep -v "^[[:space:]]*//" | grep -v "^[[:space:]]*\*" | wc -l)

if [ $CONSOLE_LOGS -gt 0 ]; then
    echo "⚠️  Warning: $CONSOLE_LOGS console.log statements found in production code"
    echo "Consider removing these before deployment."
fi

# Check service worker version
echo ""
echo "📦 Checking service worker version..."
SW_VERSION=$(grep -E "const CACHE_VERSION = '[^']+'" sw.js | sed -E "s/.*'([^']+)'.*/\1/")
if [ -z "$SW_VERSION" ]; then
    echo "⚠️  Warning: Could not determine service worker version"
else
    echo "Current SW version: $SW_VERSION"
    echo "Remember to bump version if you've made changes!"
fi

# Generate deployment readiness report
echo ""
echo "📋 Generating deployment readiness report..."

REPORT_FILE="tests/reports/push-validation-$(date +%Y%m%d-%H%M%S).json"
mkdir -p tests/reports

cat > "$REPORT_FILE" << EOF
{
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "branch": "$(git branch --show-current)",
  "commit": "$(git rev-parse HEAD)",
  "tests": {
    "passed": true,
    "report": "tests/reports/latest.json"
  },
  "codeQuality": {
    "consoleLogs": $CONSOLE_LOGS,
    "serviceWorkerVersion": "$SW_VERSION"
  },
  "ready": true
}
EOF

echo "✅ Deployment readiness report: $REPORT_FILE"

# Show summary
echo ""
echo "="
echo "📊 PRE-PUSH SUMMARY"
echo "="
echo "✅ All tests passed"
echo "📝 Console logs found: $CONSOLE_LOGS"
echo "📦 SW Version: $SW_VERSION"
echo "🚀 Ready to push!"
echo ""

exit 0