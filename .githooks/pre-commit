#!/bin/bash

# Pre-commit hook for StackMap
# Runs tests and validates code before allowing commit

echo "🔍 Running pre-commit checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Run tests if test framework exists
if [ -f "package.json" ] && [ -f "tests/run-tests.js" ]; then
    echo "Running UAT tests..."
    
    # Check if running in CI or automated environment
    if [ -n "$CI" ] || [ ! -t 1 ]; then
        echo "Skipping tests in CI environment"
    else
        # Run tests
        npm test > test-output.tmp 2>&1
        TEST_RESULT=$?
        
        # Check results
        if [ $TEST_RESULT -ne 0 ]; then
            echo -e "${RED}❌ Tests failed!${NC}"
            echo "Test output:"
            cat test-output.tmp
            rm test-output.tmp
            echo ""
            echo "Please fix failing tests before committing."
            exit 1
        else
            echo -e "${GREEN}✅ All tests passed${NC}"
            rm test-output.tmp
        fi
    fi
fi

# Check for console.log statements (commented out ones are OK)
echo "Checking for console.log statements..."
CONSOLE_LOGS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx)$' | xargs grep -n "^[^/]*console\.log" || true)

if [ ! -z "$CONSOLE_LOGS" ]; then
    echo -e "${YELLOW}⚠️  Warning: Found console.log statements:${NC}"
    echo "$CONSOLE_LOGS"
    echo ""
    read -p "Remove console.log statements before committing? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

# Check for large files
echo "Checking file sizes..."
LARGE_FILES=$(git diff --cached --name-only | xargs ls -la 2>/dev/null | awk '$5 > 1048576 {print $9 " (" $5 " bytes)"}')

if [ ! -z "$LARGE_FILES" ]; then
    echo -e "${YELLOW}⚠️  Warning: Large files detected (>1MB):${NC}"
    echo "$LARGE_FILES"
    echo ""
    echo "Consider optimizing images or moving large assets to CDN"
    read -p "Continue with large files? (y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

echo -e "${GREEN}✅ Pre-commit checks passed${NC}"