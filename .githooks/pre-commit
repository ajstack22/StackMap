#!/bin/bash

echo "🔍 Running pre-commit checks..."

# Run critical story tests - block commit if they fail
echo "🧪 Running critical story tests..."
if [ -f "tests/story-runner.js" ]; then
    node tests/story-runner.js --critical-only
    TEST_EXIT_CODE=$?
    
    if [ $TEST_EXIT_CODE -ne 0 ]; then
        echo ""
        echo "❌ COMMIT BLOCKED: Critical tests failed!"
        echo "Please fix failing tests before committing."
        echo ""
        echo "To see detailed test results:"
        echo "  - Check test-results/story-report.json"
        echo "  - Run: npm run test:story --debug"
        echo ""
        exit 1
    fi
    echo "✅ All critical tests passed"
elif [ -f "tests/test-runner-enhanced.js" ]; then
    # Fallback to existing test runner
    node tests/test-runner-enhanced.js
    TEST_EXIT_CODE=$?
    
    if [ $TEST_EXIT_CODE -ne 0 ]; then
        echo ""
        echo "❌ COMMIT BLOCKED: Tests failed!"
        echo "Please fix failing tests before committing."
        echo ""
        exit 1
    fi
    echo "✅ All tests passed"
else
    echo "⚠️  No test runner found, skipping test validation"
fi

echo ""

# Check for duplicate CSS selectors
echo "Checking for duplicate CSS selectors..."
for css_file in styles/*.css; do
    if [ -f "$css_file" ]; then
        # Extract selectors and look for duplicates
        duplicates=$(grep -E '^\s*\.[a-zA-Z0-9_-]+\s*\{' "$css_file" | sort | uniq -d)
        if [ ! -z "$duplicates" ]; then
            echo "❌ Duplicate selectors found in $css_file:"
            echo "$duplicates"
            echo "Consider consolidating these rules!"
            # Don't block, just warn
        fi
    fi
done

# Check for console.log in production files
if grep -r "console\.log" --include="*.js" --exclude-dir=node_modules --exclude-dir=tests . | grep -v "^[[:space:]]*//" | grep -v "^[[:space:]]*\*"; then
    echo "⚠️  console.log found in production code (see above)"
fi

# Check for conflict markers
if find . -name "*.js" -o -name "*.css" -o -name "*.html" | xargs grep -l "<<<<<<< HEAD" 2>/dev/null; then
    echo "❌ Merge conflict markers found!"
    exit 1
fi

# Check CSS file imports match between index.css and demo/index.html
echo "Checking CSS consistency between main and demo..."
main_imports=$(grep "@import" styles/index.css | sort)
# Note: Demo loads files differently, just log for awareness
echo "ℹ️  Remember: demo/index.html loads CSS files individually"

# Warn about large files
large_files=$(find . -name "*.js" -o -name "*.css" -size +100k 2>/dev/null | grep -v node_modules)
if [ ! -z "$large_files" ]; then
    echo "⚠️  Large files detected (>100KB):"
    echo "$large_files"
fi

# Final summary
if [ -f "tests/reports/latest.json" ]; then
    echo ""
    echo "📊 Test Summary:"
    node -e "
        const report = require('./tests/reports/latest.json');
        const {total, passed, failed} = report.summary;
        console.log('  Total: ' + total);
        console.log('  Passed: ' + passed);
        console.log('  Failed: ' + failed);
        console.log('  Success Rate: ' + Math.round((passed/total)*100) + '%');
    " 2>/dev/null || echo "  (Could not parse test report)"
fi

echo ""
echo "✅ Pre-commit checks complete"